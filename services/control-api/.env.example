NODE_ENV=production
HOST=0.0.0.0
PORT=8080
CONTROL_API_ADAPTER_MODE=production

DATABASE_URL=
DATABASE_SSL=require
DATABASE_POOL_MAX=10
AUTH_SESSION_DATABASE_POOL_MAX=5

CONTROL_API_DATA_ADAPTER_MODULE=./src/adapters/postgres.js
CONTROL_API_AUTH_ADAPTER_MODULE=./src/adapters/jwks-auth.js
CONTROL_API_AUTH_SESSION_ADAPTER_MODULE=./src/adapters/auth-session.js
CONTROL_API_PURCHASE_ADAPTER_MODULE=./src/adapters/google-play.js
CONTROL_API_PLAY_NOTIFICATIONS_ADAPTER_MODULE=./src/adapters/google-play-rtdn.js
CONTROL_API_TELEGRAM_AUTH_ADAPTER_MODULE=./src/adapters/telegram-oidc.js
CONTROL_API_ENTERPRISE_SECURITY_ADAPTER_MODULE=./src/enterprise.js
CONTROL_API_SERVER_SECRET_ADAPTER_MODULE=./src/adapters/file-server-secret.js
CONTROL_API_SERVER_SECRET_DIR=/run/secrets/ganj/servers
CONTROL_API_TELEGRAM_ACCOUNT_BROKER_MODULE=./src/adapters/auth-session.js
CONTROL_API_ASSIGNMENT_SECRET_FILE=/run/secrets/ganj/assignment-key
CONTROL_API_RUNTIME_CONFIG_PRIVATE_KEY_FILE=/run/secrets/ganj/runtime-config-ed25519.pem
CONTROL_API_RUNTIME_CONFIG_KEY_VERSION=runtime-config-ed25519-v1

AUTH_JWKS_URI=
AUTH_ISSUER=https://control.example.com
AUTH_AUDIENCE=ganj-control-api
AUTH_ALLOWED_ALGORITHMS=EdDSA
AUTH_TOKEN_USE=access
AUTH_SESSION_SIGNING_PRIVATE_JWK_FILE=/run/secrets/ganj/auth-session-private.jwk
AUTH_SESSION_SIGNING_KEY_ID=auth-session-ed25519-v1
AUTH_ACCESS_TOKEN_SECONDS=300
AUTH_REFRESH_TOKEN_SECONDS=2592000

TELEGRAM_OIDC_AUTHORIZATION_ENDPOINT=
TELEGRAM_OIDC_TOKEN_ENDPOINT=
TELEGRAM_OIDC_JWKS_URI=
TELEGRAM_OIDC_ISSUER=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET_FILE=/run/secrets/ganj/telegram-oidc-client-secret
TELEGRAM_OIDC_REDIRECT_URIS=https://control.example.com/auth/telegram/callback

GOOGLE_PLAY_PACKAGE_NAME=com.ganj.vpn
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/run/secrets/ganj/google-play-service-account.json
PLAY_RTDN_AUDIENCE=
PLAY_RTDN_SERVICE_ACCOUNT=
PLAY_RTDN_SUBSCRIPTION=
