-	return nodep.PingHTTPRequest(client, targetURL, timeout)
+	return pingV2rayNGRealDelay(client, targetURL)
+}
+
+// pingV2rayNGRealDelay follows AndroidLibXrayLite's measureInstDelay logic:
+// two GETs via the same outbound, read and close the body to allow HTTP
+// keep-alive, accept only HTTP 200/204, and return the fastest successful
+// request. Startup, config parsing and endpoint lease times are not measured.
+func pingV2rayNGRealDelay(client *http.Client, targetURL string) (int64, error) {
+	const samples = 2
+	minimum := int64(-1)
+	var lastErr error
+	for i := 0; i < samples; i++ {
+		req, err := http.NewRequest(http.MethodGet, targetURL, nil)
+		if err != nil {
+			lastErr = err
+			continue
+		}
+		started := time.Now()
+		response, err := client.Do(req)
+		if err != nil {
+			lastErr = err
+			continue
+		}
+		_, readErr := io.Copy(io.Discard, response.Body)
+		closeErr := response.Body.Close()
+		if response.StatusCode != http.StatusOK && response.StatusCode != http.StatusNoContent {
+			lastErr = fmt.Errorf("invalid status: %s", response.Status)
+			continue
+		}
+		if readErr != nil {
+			lastErr = fmt.Errorf("failed to read response body: %w", readErr)
+			continue
+		}
+		if closeErr != nil {
+			lastErr = fmt.Errorf("failed to close response body: %w", closeErr)
+			continue
+		}
+		duration := time.Since(started).Milliseconds()
+		if minimum == -1 || duration < minimum {
+			minimum = duration
+		}
+	}
+	if minimum == -1 {
+		if lastErr == nil {
+			lastErr = errors.New("real delay: both attempts failed")
+		}
+		return nodep.PingDelayError, lastErr
+	}
+	return minimum, nil
 }
 
