@@ -0,0 +1,78 @@
+package xray
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestPingV2rayNGRealDelayReusesConnectionAndReturnsFastest(t *testing.T) {
+	var mu sync.Mutex
+	requests := 0
+	connections := map[string]bool{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		requests++
+		attempt := requests
+		connections[r.RemoteAddr] = true
+		mu.Unlock()
+		if r.Method != http.MethodGet {
+			t.Errorf("wanted GET; got %s", r.Method)
+		}
+		if attempt == 1 {
+			time.Sleep(100 * time.Millisecond)
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+	transport := &http.Transport{DisableKeepAlives: false}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: 2 * time.Second}
+	measured, err := pingV2rayNGRealDelay(client, server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if measured < 0 || measured >= 90 {
+		t.Fatalf("fastest request was %dms", measured)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if requests != 2 {
+		t.Fatalf("expected 2 GETs; got %d", requests)
+	}
+	if len(connections) != 1 {
+		t.Fatalf("expected single reusable TCP connection; got %d", len(connections))
+	}
+}
+
+func TestPingV2rayNGRealDelayRejectsNon204Non200(t *testing.T) {
+	requests := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests++
+		w.WriteHeader(http.StatusForbidden)
+	}))
+	defer server.Close()
+	measured, err := pingV2rayNGRealDelay(server.Client(), server.URL)
+	if err == nil || measured != 10000 || requests != 2 {
+		t.Fatalf("unexpected failure handling delay=%d err=%v requests=%d", measured, err, requests)
+	}
+}
+
+func TestPingV2rayNGRealDelayOneValidResultStillSucceeds(t *testing.T) {
+	requests := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests++
+		if requests == 1 {
+			w.WriteHeader(http.StatusOK)
+		} else {
+			w.WriteHeader(http.StatusForbidden)
+		}
+	}))
+	defer server.Close()
+	measured, err := pingV2rayNGRealDelay(server.Client(), server.URL)
+	if err != nil || measured < 0 || requests != 2 {
+		t.Fatalf("expected valid first result; delay=%d err=%v requests=%d", measured, err, requests)
+	}
+}
