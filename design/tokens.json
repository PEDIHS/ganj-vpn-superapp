{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Ganj Design Tokens",
    "version": "0.1.0",
    "direction": ["rtl", "ltr"]
  },
  "color": {
    "dark": {
      "bgCanvas": { "$type": "color", "$value": "#060A12" },
      "bgElevated": { "$type": "color", "$value": "#0D1424" },
      "surfacePrimary": { "$type": "color", "$value": "#111B2E" },
      "textPrimary": { "$type": "color", "$value": "#F5F7FB" },
      "textSecondary": { "$type": "color", "$value": "#A8B3C7" },
      "brandPrimary": { "$type": "color", "$value": "#0A84FF" },
      "connected": { "$type": "color", "$value": "#30D158" },
      "warning": { "$type": "color", "$value": "#FFB340" },
      "danger": { "$type": "color", "$value": "#FF453A" },
      "vipStart": { "$type": "color", "$value": "#F8DF8B" },
      "vipEnd": { "$type": "color", "$value": "#B7791F" }
    },
    "light": {
      "bgCanvas": { "$type": "color", "$value": "#F6F8FC" },
      "bgElevated": { "$type": "color", "$value": "#FFFFFF" },
      "surfacePrimary": { "$type": "color", "$value": "#FFFFFF" },
      "textPrimary": { "$type": "color", "$value": "#0A1020" },
      "textSecondary": { "$type": "color", "$value": "#5F6B7A" },
      "brandPrimary": { "$type": "color", "$value": "#007AFF" },
      "connected": { "$type": "color", "$value": "#248A3D" },
      "warning": { "$type": "color", "$value": "#B35C00" },
      "danger": { "$type": "color", "$value": "#D70015" }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": { "value": 10, "unit": "dp" } },
    "md": { "$type": "dimension", "$value": { "value": 16, "unit": "dp" } },
    "lg": { "$type": "dimension", "$value": { "value": 24, "unit": "dp" } },
    "pill": { "$type": "dimension", "$value": { "value": 999, "unit": "dp" } }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": { "value": 4, "unit": "dp" } },
    "sm": { "$type": "dimension", "$value": { "value": 8, "unit": "dp" } },
    "md": { "$type": "dimension", "$value": { "value": 12, "unit": "dp" } },
    "lg": { "$type": "dimension", "$value": { "value": 20, "unit": "dp" } },
    "xl": { "$type": "dimension", "$value": { "value": 32, "unit": "dp" } }
  },
  "motion": {
    "microMs": { "$type": "duration", "$value": "160ms" },
    "standardMs": { "$type": "duration", "$value": "260ms" },
    "sheetMs": { "$type": "duration", "$value": "380ms" },
    "connectMs": { "$type": "duration", "$value": "600ms" }
  }
}

