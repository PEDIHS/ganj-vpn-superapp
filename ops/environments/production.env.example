GANJ_ENVIRONMENT=production
CONTROL_API_IMAGE=ghcr.io/pedihs/ganj-vpn-control-api@sha256:REPLACE_WITH_PROMOTED_DIGEST
POSTGRES_IMAGE=postgres:16.15-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
NGINX_IMAGE=nginx:1.29.1-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
GANJ_SECRETS_DIR=/etc/ganj-vpn/secrets
PUBLIC_HTTPS_BIND=0.0.0.0
PUBLIC_HTTPS_PORT=443
POSTGRES_DB=ganj_control
POSTGRES_USER=ganj_control
DATABASE_SSL=disable
RUNTIME_CONFIG_KEY_VERSION=runtime-config-ed25519-v1
AUTH_JWKS_URI=https://identity.example.invalid/.well-known/jwks.json
AUTH_ISSUER=https://identity.example.invalid/
AUTH_AUDIENCE=ganj-control-api
TELEGRAM_OIDC_TOKEN_ENDPOINT=https://identity.example.invalid/oauth/token
TELEGRAM_OIDC_JWKS_URI=https://identity.example.invalid/.well-known/jwks.json
TELEGRAM_OIDC_ISSUER=https://identity.example.invalid/
TELEGRAM_OIDC_CLIENT_ID=ganj-mobile
GOOGLE_PLAY_PACKAGE_NAME=com.ganj.vpn
PLAY_RTDN_AUDIENCE=https://api.example.invalid/v1/billing/play/rtdn
PLAY_RTDN_SERVICE_ACCOUNT=play-rtdn@example.invalid
PLAY_RTDN_SUBSCRIPTION=projects/replace/subscriptions/play-rtdn
SERVER_SECRET_RESOLVER_URL=https://secrets.example.invalid/
TELEGRAM_ACCOUNT_BROKER_URL=https://identity.example.invalid/
