{
  "schemaVersion": 1,
  "environment": "production",
  "defaults": {
    "noDataBehavior": "alert",
    "evaluationIntervalSeconds": 60,
    "labels": {
      "product": "ganj-vpn",
      "dataClassification": "operational-no-pii"
    }
  },
  "rules": [
    {
      "id": "android.release.crash_free_users",
      "severity": "SEV-1",
      "owner": "mobile-platform",
      "signal": "android.crash_free_users.percent",
      "operator": "lt",
      "threshold": 99.2,
      "windowMinutes": 15,
      "minimumSamples": 500,
      "forMinutes": 5,
      "cooldownMinutes": 30,
      "dimensions": ["app_version", "release_channel"],
      "routes": ["oncall.mobile", "incident.telegram"],
      "runbook": "docs/13-incident-response-runbook.fa.md"
    },
    {
      "id": "android.release.anr_rate",
      "severity": "SEV-1",
      "owner": "mobile-platform",
      "signal": "android.anr.sessions.percent",
      "operator": "gt",
      "threshold": 0.47,
      "windowMinutes": 15,
      "minimumSamples": 500,
      "forMinutes": 5,
      "cooldownMinutes": 30,
      "dimensions": ["app_version", "release_channel"],
      "routes": ["oncall.mobile", "incident.telegram"],
      "runbook": "docs/13-incident-response-runbook.fa.md"
    },
    {
      "id": "vpn.connection.success_rate",
      "severity": "SEV-1",
      "owner": "vpn-reliability",
      "signal": "vpn.connection.success.percent",
      "operator": "lt",
      "threshold": 90,
      "windowMinutes": 10,
      "minimumSamples": 200,
      "forMinutes": 5,
      "cooldownMinutes": 20,
      "dimensions": ["app_version", "protocol", "network_type", "server_region"],
      "routes": ["oncall.vpn", "incident.telegram"],
      "runbook": "docs/13-incident-response-runbook.fa.md"
    },
    {
      "id": "vpn.connection.p95_latency",
      "severity": "SEV-2",
      "owner": "vpn-reliability",
      "signal": "vpn.connection.latency.p95_ms",
      "operator": "gt",
      "threshold": 8000,
      "windowMinutes": 10,
      "minimumSamples": 100,
      "forMinutes": 10,
      "cooldownMinutes": 30,
      "dimensions": ["app_version", "protocol", "server_region"],
      "routes": ["oncall.vpn", "ticket.reliability"],
      "runbook": "docs/13-incident-response-runbook.fa.md"
    },
    {
      "id": "commerce.entitlement_mismatch",
      "severity": "SEV-1",
      "owner": "commerce-platform",
      "signal": "commerce.entitlement_mismatch.count",
      "operator": "gt",
      "threshold": 0,
      "windowMinutes": 5,
      "minimumSamples": 1,
      "forMinutes": 0,
      "cooldownMinutes": 15,
      "dimensions": ["provider", "product_id", "app_version"],
      "routes": ["oncall.commerce", "incident.telegram"],
      "runbook": "docs/13-incident-response-runbook.fa.md"
    },
    {
      "id": "commerce.verification.backlog_age",
      "severity": "SEV-1",
      "owner": "commerce-platform",
      "signal": "commerce.verification.oldest_pending.seconds",
      "operator": "gt",
      "threshold": 180,
      "windowMinutes": 5,
      "minimumSamples": 1,
      "forMinutes": 5,
      "cooldownMinutes": 15,
      "dimensions": ["provider"],
      "routes": ["oncall.commerce", "incident.telegram"],
      "runbook": "docs/13-incident-response-runbook.fa.md"
    },
    {
      "id": "api.control.error_rate",
      "severity": "SEV-1",
      "owner": "control-api",
      "signal": "api.control.responses.5xx_percent",
      "operator": "gt",
      "threshold": 2,
      "windowMinutes": 5,
      "minimumSamples": 200,
      "forMinutes": 5,
      "cooldownMinutes": 20,
      "dimensions": ["route_group", "deployment"],
      "routes": ["oncall.backend", "incident.telegram"],
      "runbook": "docs/13-incident-response-runbook.fa.md"
    },
    {
      "id": "api.control.p95_latency",
      "severity": "SEV-2",
      "owner": "control-api",
      "signal": "api.control.latency.p95_ms",
      "operator": "gt",
      "threshold": 800,
      "windowMinutes": 10,
      "minimumSamples": 200,
      "forMinutes": 10,
      "cooldownMinutes": 30,
      "dimensions": ["route_group", "deployment"],
      "routes": ["oncall.backend", "ticket.reliability"],
      "runbook": "docs/13-incident-response-runbook.fa.md"
    },
    {
      "id": "security.authentication.abuse",
      "severity": "SEV-1",
      "owner": "security",
      "signal": "security.authentication.blocked_attempts.count",
      "operator": "gt",
      "threshold": 100,
      "windowMinutes": 5,
      "minimumSamples": 100,
      "forMinutes": 0,
      "cooldownMinutes": 15,
      "dimensions": ["reason_code", "coarse_region"],
      "routes": ["oncall.security", "incident.telegram"],
      "runbook": "docs/13-incident-response-runbook.fa.md"
    },
    {
      "id": "vpn.server.probe_failures",
      "severity": "SEV-2",
      "owner": "vpn-reliability",
      "signal": "vpn.server.consecutive_probe_failures.count",
      "operator": "gte",
      "threshold": 3,
      "windowMinutes": 5,
      "minimumSamples": 3,
      "forMinutes": 0,
      "cooldownMinutes": 15,
      "dimensions": ["server_id", "server_region"],
      "routes": ["oncall.vpn", "ticket.reliability"],
      "runbook": "docs/13-incident-response-runbook.fa.md"
    },
    {
      "id": "operations.backup.age",
      "severity": "SEV-1",
      "owner": "platform-operations",
      "signal": "operations.backup.last_verified_age.hours",
      "operator": "gt",
      "threshold": 26,
      "windowMinutes": 15,
      "minimumSamples": 1,
      "forMinutes": 15,
      "cooldownMinutes": 60,
      "dimensions": ["backup_class"],
      "routes": ["oncall.platform", "incident.telegram"],
      "runbook": "docs/13-incident-response-runbook.fa.md"
    },
    {
      "id": "release.signing.certificate_expiry",
      "severity": "SEV-2",
      "owner": "release-security",
      "signal": "release.signing.certificate_days_remaining",
      "operator": "lt",
      "threshold": 45,
      "windowMinutes": 60,
      "minimumSamples": 1,
      "forMinutes": 0,
      "cooldownMinutes": 1440,
      "dimensions": ["key_purpose"],
      "routes": ["oncall.security", "ticket.release"],
      "runbook": "docs/12-release-and-update-runbook.fa.md"
    }
  ]
}
